{
  "expo": {
    "name": "GoFolio",
    "slug": "gofolio",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "cover",
      "backgroundColor": "#02000a"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.ganpati.gofolio"
    },
    "android": {
      "package": "com.ganpati.gofolio",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0a0420"
      },
      "edgeToEdgeEnabled": true
    },
    "web": {
      "favicon": "./assets/favicon.png"
    }
  }
}
